[Unit]
Description=ReleaseGuard fixed-operation Docker Compose helper
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/releaseguard
EnvironmentFile=/opt/releaseguard/.env
ExecStart=/usr/bin/python3 /opt/releaseguard/deployment/host_agent.py
RuntimeDirectory=releaseguard
RuntimeDirectoryPreserve=yes
StateDirectory=releaseguard-agent
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/releaseguard /var/lib/releaseguard-agent

[Install]
WantedBy=multi-user.target
